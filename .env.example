# Environment variables xencode reads. Every one is optional.
#
# xencode does not load a .env file by itself. To use this file, copy it to
# .env (which git ignores), uncomment and fill in what you need, and load it
# into your shell:
#   set -a; . ./.env; set +a          # bash / zsh
# The usual home for settings is ~/.config/xencode/config.json (on Windows,
# %APPDATA%\xencode\config.json), written by `xencode config set`. A provider
# key is taken from that file first, then from a `command:` reference in it,
# and only then from the variables below. `xencode config show` says which of
# the three each key came from, without printing the key.

# --- Provider API keys -------------------------------------------------------
# API_KEY_OPENAI=
# API_KEY_OPENROUTER=
# API_KEY_GEMINI=
# API_KEY_QWEN=
# The key for a remote endpoint you run yourself (API_KEY_REMOTE also works).
# XENCODE_API_KEY=
# NVIDIA NIM (API_KEY_NVIDIA also works).
# NVIDIA_NIM_API_KEY=
# Web search providers.
# API_KEY_BRAVE=
# API_KEY_TAVILY=

# --- Where xencode keeps things ----------------------------------------------
# Directory holding config.json, instead of the platform's config directory.
# XCODE_CONFIG_DIR=
# Directory plugins are installed to and loaded from.
# XCODE_PLUGIN_DIR=
# Directory skills are loaded from.
# XCODE_SKILLS_DIR=

# --- Behavior ----------------------------------------------------------------
# Set to 0, false, no or off to turn off keyword matching in context retrieval.
# XCODE_HYBRID=
# Log level for `xencode server`, e.g. warn, or xencode_server_rs=debug.
# RUST_LOG=
# Any non-empty value turns off colors in the TUI.
# NO_COLOR=
