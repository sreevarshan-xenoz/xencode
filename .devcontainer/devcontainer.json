// A ready Rust environment for working on xencode: open the repository in a
// dev container (VS Code, GitHub Codespaces, or `devcontainer up`) and the
// workspace is built once the container is created.
{
  "name": "xencode",
  "image": "mcr.microsoft.com/devcontainers/rust:1-bookworm",
  "postCreateCommand": "rustup component add rustfmt clippy && cargo build --manifest-path rust/Cargo.toml",
  "forwardPorts": [8765],
  "customizations": {
    "vscode": {
      "extensions": ["rust-lang.rust-analyzer", "tamasfe.even-better-toml"],
      "settings": {
        "rust-analyzer.linkedProjects": ["rust/Cargo.toml"]
      }
    }
  }
}
